# development en tu maquina; production en el servidor. En production la
# API no arranca si falta algo o queda un valor de desarrollo (root, CORS
# a localhost, secreto corto): ver src/config/entorno.js
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=itdesk
# base que crean las pruebas de integracion (opcional, por defecto DB_NAME_test)
DB_NAME_TEST=itdesk_test

# en production, al menos 32 caracteres al azar
JWT_SECRET=
JWT_EXPIRES_IN=8h

# URL del frontend que puede llamar a la API, separadas por coma y sin la
# barra final (ej. https://itdesk.onrender.com). Vacio en desarrollo = sin
# restriccion; obligatorio en production.
CORS_ORIGINS=

# --- Usuarios de MySQL con privilegios minimos (npm run db:usuarios) ---
# Solo en la maquina de quien corre el script, nunca en el servidor:
# DB_ROOT_* es quien crea los usuarios. Las claves, de 12 caracteres o mas.
# Despues, el backend en produccion usa DB_USER=itdesk_app y su clave.
# Ver docs/privilegios-base-de-datos.md
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
DB_APP_USER=itdesk_app
DB_APP_PASSWORD=
DB_ADMIN_USER=itdesk_admin
DB_ADMIN_PASSWORD=
DB_USERS_HOST=%
